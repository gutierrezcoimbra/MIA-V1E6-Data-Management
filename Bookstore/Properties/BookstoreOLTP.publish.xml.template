<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to BookstoreOLTP.publish.xml before publishing.
  It intentionally uses Windows authentication and contains no credentials.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetConnectionString>Data Source=localhost;Initial Catalog=Bookstore;Integrated Security=True;TrustServerCertificate=True</TargetConnectionString>
    <TargetDatabaseName>Bookstore</TargetDatabaseName>
    <BlockOnPossibleDataLoss>True</BlockOnPossibleDataLoss>
    <DropObjectsNotInSource>False</DropObjectsNotInSource>
    <ScriptDatabaseOptions>False</ScriptDatabaseOptions>
    <IncludeTransactionalScripts>True</IncludeTransactionalScripts>
    <ProfileVersionNumber>1</ProfileVersionNumber>
  </PropertyGroup>
</Project>
