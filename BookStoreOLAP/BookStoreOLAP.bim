        "partitions": [
          {
            "name": "FactOrders",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [dbo].[FactOrders].*   FROM [dbo].[FactOrders] ",
              "dataSource": "SqlServer LAPTOP-LTNQC5A3 BookstoreDW"
            }
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expression": "SUM(Orders[Price])"
          },
          {
            "name": "Order Count",
            "expression": " DISTINCTCOUNT ( Orders[OrderID] )"
          },
          {
            "name": "Line Items",
            "expression": " COUNTROWS ( Orders )"
          },
          {
            "name": "Avg Lines Per Order",
            "expression": " DIVIDE ( [Line Items], [Order Count] )"
          },
          {
            "name": "Delivered Orders",
            "expression": [
              "",
              "CALCULATE (",
              "    DISTINCTCOUNT ( Orders[OrderID] ),",
              "    Orders[OrderStatus] = \"Delivered\"",
              ")"
            ]
          },
          {
            "name": "Pending Delivery Orders",
            "expression": [
              "",
              "CALCULATE (",
              "    DISTINCTCOUNT ( Orders[OrderID] ),",
              "    Orders[OrderStatus] = \"Pending Delivery\"",
              ")"
            ]
          },
          {
            "name": "Canceled Delivery Orders",
            "expression": [
              "",
              "CALCULATE (",
              "    DISTINCTCOUNT ( Orders[OrderID] ),",
              "    Orders[OrderStatus] = \"Cancelled\"",
              ")"
            ]
          },
          {
            "name": "In Progress Delivery Orders",
            "expression": [
              "",
              "CALCULATE (",
              "    DISTINCTCOUNT ( Orders[OrderID] ),",
              "    Orders[OrderStatus] = \"Delivery In Progress\"",
              ")"
            ]
          },
          {
            "name": "Cancelled Amount",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( Orders[Price] ),",
              "    Orders[OrderStatus] = \"Cancelled\"",
              ")"
            ]
          },
          {
            "name": "Returned Amount",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( Orders[Price] ),",
              "    Orders[OrderStatus] = \"Returned\"",
              ")"
            ]
          },
          {
            "name": "Net Revenue",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( Orders[Price] ),",
              "    Orders[OrderStatus] = \"Delivered\"",
              ")"
            ]
          },
          {
            "name": "Cancel Rate",
            "expression": " DIVIDE ( [Cancelled Amount], [Revenue] )"
          }
        ],
        "annotations": [
